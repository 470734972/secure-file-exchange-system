[Unit]
Description=Secure File Exchange
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sfx
Group=sfx
WorkingDirectory=/opt/secure-file-exchange
EnvironmentFile=/etc/secure-file-exchange/sfx.env
ExecStart=/usr/bin/node /opt/secure-file-exchange/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/secure-file-exchange
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
